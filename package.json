{
  "name": "cli-heartbeat-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run short local Claude Code, Codex, and Antigravity CLI heartbeat prompts on a schedule.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cli-heartbeat-scheduler": "./src/index.js"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/index.js start --config examples/config.example.json",
    "doctor": "node src/index.js doctor --config examples/config.example.json",
    "next": "node src/index.js next --config examples/config.example.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2"
  }
}
